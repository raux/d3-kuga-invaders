{
  "name": "Kuga Invaders",
  "short_name": "Kuga Invaders",
  "description": "A responsive D3.js arcade defense game.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
